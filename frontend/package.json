{
  "name": "shockpath-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate:types": "openapi-typescript ../config/openapi.json -o src/types/generated/api.d.ts",
    "test:routes": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.104.0",
    "echarts": "6.1.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
