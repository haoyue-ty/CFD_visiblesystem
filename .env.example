SCIENTIFIC_DATA_ROOT=
INVENTORY_PATH=
CANONICAL_REGISTRY_PATH=
API_HOST=
API_PORT=
ENABLE_ACCOUNTS=true
QQ_SMTP_EMAIL=
QQ_SMTP_AUTH_CODE=
AUTH_DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3308/shockpath_accounts
# Optional; when empty, a local random key is persisted in runtime/auth/secret.key.
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Backend environment only; serve_backend loads .env without overriding process settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_TOKEN_BUDGET=500000
AI_MAX_INPUT_CHARS=32000
# P6 HTML reports need no additional environment variables or provider calls.
# Validated current-model AI caches are optional; no key still permits full deterministic reports.
# P3 runtime limits (single numerical worker; dedicated threads for SSE and APIs)
MAX_CONCURRENT_RUNS=1
MAX_QUEUED_RUNS=3
MAX_RUN_SECONDS=1800
MAX_RUN_OUTPUT_BYTES=67108864
WAITRESS_THREADS=12
MAX_SSE_CONNECTIONS=4

# Phase B: export caches are independent from the 64 MiB Solver output limit.
MAX_CONCURRENT_EXPORTS=2
MAX_EXPORT_CACHE_BYTES=268435456
MAX_TOTAL_EXPORT_CACHE_BYTES=2147483648
MAX_EXPORT_SECONDS=90
EXPORT_PDF_ENABLED=true
# Optional trusted Chromium executable; otherwise discover local Chrome/Edge/Chromium.
EXPORT_PDF_BROWSER=
